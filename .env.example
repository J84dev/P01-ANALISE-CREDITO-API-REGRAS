# Copie para .env (que está no .gitignore) e troque os valores. Dados fictícios apenas.
# Gere uma chave com: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Troque por uma chave forte antes de usar (a API não valida o tamanho).
API_KEY=TROQUE-ME
REGRAS_VERSAO=1.0.2
# Só para uso local: habilita a página /docs.
API_DOCS=1
